<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" Sdk="Microsoft.Docker.Sdk">
  <PropertyGroup>
    <ProjectVersion>2.1</ProjectVersion>
    <DockerTargetOS>Linux</DockerTargetOS>
    <DockerPublishLocally>False</DockerPublishLocally>
    <ProjectGuid>{e3b5c8f1-7a4d-4c9e-b2e6-8f5a3d7c1e09}</ProjectGuid>
    <DockerLaunchAction>LaunchBrowser</DockerLaunchAction>
    <DockerServiceUrl>{Scheme}://localhost:{ServicePort}</DockerServiceUrl>
    <!-- This project is orchestrated by Docker Desktop/VS; skip NuGet restore so
         'dotnet build microservice.sln' works from the command line. -->
    <RestoreProjectStyle>None</RestoreProjectStyle>
  </PropertyGroup>
  <ItemGroup>
    <None Include="docker-compose.yaml" />
    <None Include=".dockerignore" />
  </ItemGroup>
</Project>