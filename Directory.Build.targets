<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <PropertyGroup>
        <EntityFrameworkVersion>10.0.0</EntityFrameworkVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- Asp.Net Core -->
        <PackageReference Update="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
        <PackageReference Update="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.0" />
        <PackageReference Update="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.0" />
        <PackageReference Update="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
        <PackageReference Update="AspNetCore.HealthChecks.SqlServer" Version="9.0.0" />
        <PackageReference Update="AspNetCore.HealthChecks.AzureServiceBus" Version="9.0.0" />
        <PackageReference Update="AspNetCore.HealthChecks.MongoDb" Version="9.0.0" />

        <!-- Microsoft Extensions -->
        <PackageReference Update="Microsoft.Extensions.Caching.Abstractions" Version="10.0.0" />
        <PackageReference Update="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.0" />
        <PackageReference Update="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
        <PackageReference Update="Microsoft.Extensions.Configuration" Version="10.0.0" />
        <PackageReference Update="Microsoft.Extensions.Configuration.Abstractions" Version="6.0.0" />
        <PackageReference Update="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
        <PackageReference Update="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
        <PackageReference Update="Microsoft.Extensions.Http.Polly" Version="10.0.0" />
        <PackageReference Update="Microsoft.Extensions.Azure" Version="1.11.0" />
        <PackageReference Update="Microsoft.Extensions.Options" Version="10.0.0" />

        <!-- Azure -->
        <PackageReference Update="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
        <PackageReference Update="Azure.Identity" Version="1.21.0" />
        <PackageReference Update="Azure.Security.KeyVault.Secrets" Version="4.11.0" />
        <PackageReference Update="Azure.Security.KeyVault.Keys" Version="4.11.0" />
        <PackageReference Update="Azure.Security.KeyVault.Certificates" Version="4.11.0" />
        <PackageReference Update="Azure.Messaging.ServiceBus" Version="7.19.0" />

        <!-- Microsoft Entity Framework -->
        <PackageReference Update="Microsoft.EntityFrameworkCore.Relational" Version="$(EntityFrameworkVersion)" />
        <PackageReference Update="Microsoft.EntityFrameworkCore.SqlServer" Version="$(EntityFrameworkVersion)" />
        <PackageReference Update="Microsoft.EntityFrameworkCore.Design" Version="$(EntityFrameworkVersion)" PrivateAssets="All" />

        <!-- Other Microsoft packages -->
        <PackageReference Update="Microsoft.ApplicationInsights" Version="2.23.0" />
        <PackageReference Update="Microsoft.ApplicationInsights.AspNetCore" Version="2.23.0" />
        <PackageReference Update="Microsoft.ApplicationInsights.Kubernetes" Version="8.0.1" />
        <PackageReference Update="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.2" />
        <PackageReference Update="Microsoft.VisualStudio.Azure.Kubernetes.Tools.Targets" Version="1.1.0" />
        <PackageReference Update="Microsoft.Identity.Client" Version="4.71.0" />
        <PackageReference Update="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.8.0" />
        <PackageReference Update="Microsoft.Graph" Version="5.75.0" />
        <PackageReference Update="Microsoft.TypeScript.MSBuild" Version="5.8.1" />
        <PackageReference Update="Microsoft.Data.SqlClient" Version="7.0.2" />

        <!-- Serilog -->
        <PackageReference Update="Serilog.AspNetCore" Version="10.0.0" />
        <PackageReference Update="Serilog.Expressions" Version="5.0.0" />
        <PackageReference Update="Serilog.Extensions.Logging" Version="9.0.0" />
        <PackageReference Update="Serilog.Settings.Configuration" Version="10.0.1" />
        <PackageReference Update="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Update="Serilog.Sinks.File" Version="6.0.0" />
        <PackageReference Update="Serilog.Sinks.ApplicationInsights" Version="5.0.1" />
        <!-- IdentityServer4 -->
        <PackageReference Update="IdentityServer4.AccessTokenValidation" Version="3.0.1" />
        <PackageReference Update="IdentityModel.AspNetCore" Version="4.3.0" />

        <!-- Cosmos DB -->
        <PackageReference Update="MongoDB.Bson" Version="3.11.0" />
        <PackageReference Update="MongoDB.Driver" Version="3.11.0" />
        <PackageReference Update="Microsoft.Azure.Cosmos" Version="3.48.0" />

        <!-- misc -->
        <PackageReference Update="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Update="MediatR" Version="14.2.0" />
        <PackageReference Update="AutoMapper" Version="16.2.0" />
        <PackageReference Update="Hellang.Middleware.ProblemDetails" Version="8.0.0" />
        <PackageReference Update="Acheve.Authentication.Events" Version="2.0.2" />
        <PackageReference Update="Swashbuckle.AspNetCore" Version="10.2.3" />
        <PackageReference Update="Swashbuckle.AspNetCore.Annotations" Version="7.3.0" />
        <PackageReference Update="NodaTime" Version="3.2.2" />
        <PackageReference Update="TimeZoneNames" Version="7.0.0" />

        <!-- Polly -->
        <PackageReference Update="Polly" Version="8.7.0" />
        <PackageReference Update="Polly.Contrib.Simmy" Version="0.4.0" />

        <!-- Testing -->
        <PackageReference Update="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageReference Update="xunit" Version="2.9.3" />
        <PackageReference Update="xunit.runner.visualstudio" Version="4.0.0" />
        <PackageReference Update="FluentAssertions" Version="8.10.0" />
        <PackageReference Update="coverlet.collector" Version="10.0.1" />
        <PackageReference Update="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
        <PackageReference Update="Acheve.TestHost" Version="4.0.0" />
        <PackageReference Update="Microsoft.Extensions.Hosting" Version="10.0.0" />
        <PackageReference Update="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
        <PackageReference Update="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
        <PackageReference Update="Respawn" Version="7.0.0" />
        <PackageReference Update="Moq" Version="4.20.72" />
        <PackageReference Update="Testcontainers.MongoDb" Version="4.14.0" />

        <!-- DbUp -->
        <PackageReference Update="dbup-sqlserver" Version="6.0.0" />
        <PackageReference Update="Microsoft.Azure.Services.AppAuthentication" Version="1.5.0" />
        <PackageReference Update="McMaster.Extensions.CommandLineUtils" Version="4.1.1" />

        <!--Third-party analyzers-->
        <PackageReference Update="StyleCop.Analyzers" Version="1.2.0-beta.556" />
        <PackageReference Update="SonarAnalyzer.CSharp" Version="10.33.0.1635" />
    </ItemGroup>
</Project>